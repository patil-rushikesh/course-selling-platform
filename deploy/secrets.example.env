# Copy to deploy/secrets.local.env and replace ALL values. Do not commit secrets.
# Use a URL-safe generated database password, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-database-password
DATABASE_URL=postgresql://course:replace-with-database-password@postgres:5432/course_selling
JWT_USER_PASSWORD=replace-with-a-random-secret-at-least-32-characters
JWT_ADMIN_PASSWORD=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_SIGNUP_KEY=replace-with-a-random-admin-invitation-key
