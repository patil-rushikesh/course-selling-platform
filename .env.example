# Copy to .env. Set your PostgreSQL credentials and distinct random JWT secrets.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_selling?schema=public
JWT_USER_PASSWORD=replace-with-a-long-random-user-secret
JWT_ADMIN_PASSWORD=replace-with-a-different-long-random-admin-secret
# Required for admin registration (X-Admin-Signup-Key header); use a random key.
ADMIN_SIGNUP_KEY=replace-with-a-random-admin-invitation-key
# Docker Compose database password. Use URL-safe characters, e.g. a hex secret.
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Number of trusted reverse proxies; leave 0 for direct local connections.
TRUST_PROXY_HOPS=0
# Structured JSON logs to stdout: debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info
LOG_SLOW_REQUEST_MS=1000
# Healthy liveness/readiness probes are suppressed unless explicitly enabled.
LOG_HEALTH_CHECKS=false
